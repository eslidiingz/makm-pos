NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side only. Do not expose this value as NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin used to validate Origin on state-changing API requests.
APP_ORIGIN=http://localhost:3100
# Optional, development only: comma-separated local-device origins allowed to
# make state-changing requests. Do not use this to allow production origins.
DEV_ALLOWED_ORIGINS=http://192.168.1.41:3100

# Generate with: openssl rand -base64 32
AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# The phone remains the user-facing login ID. The internal email is server-only and
# lets Supabase authenticate with Email/Password without an SMS provider.
PLATFORM_OWNER_PHONE=0812345678
PLATFORM_OWNER_AUTH_EMAIL=platform-owner@example.invalid
# Only needed while running pnpm auth:bootstrap-owner.
PLATFORM_OWNER_TEMP_PASSWORD=replace-with-a-random-password-at-least-16-characters

# Cloudflare R2 product images. Server-side only except the public base URL,
# which is returned by Elysia as part of product DTOs.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-bucket-scoped-access-key-id
R2_SECRET_ACCESS_KEY=your-bucket-scoped-secret-access-key
R2_BUCKET_NAME=makm
# The exact prefix that serves objects over HTTP, including the scheme. A custom
# domain bound to this one bucket serves keys from its root
# (https://media.example.com); a domain that fronts several buckets needs the
# bucket path segment too (https://media.example.com/makm). Verify with:
#   curl -I <base-url>/catalog/products/<any-existing-key>
R2_PUBLIC_BASE_URL=https://media.example.com
